<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notice</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="grid-bg"></div>

    <div class="marquee">
        <div class="marquee-content">
            <span>NOTICE</span>
            <span>ATTENTION</span>
            <span>NOTICE</span>
            <span>ATTENTION</span>
        </div>
    </div>

    <div class="container">
        <div class="quiz-card" style="box-shadow: 16px 16px 0 var(--neo-pink);">
            <div class="card-label">NOTICE</div>
            
            <div class="result-emoji"></div>
            
            <div class="result-info">
                <p class="result-text" style="font-size: 1.8rem; line-height: 1.8;">
                    <%= message %>
                </p>
            </div>

            <% if (typeof backLink !== 'undefined') { %>
            <div class="result-actions" style="margin-top: 40px;">
                <a href="<%= backLink %>" class="action-btn primary">
                    GO BACK
                </a>
            </div>
            <% } %>
        </div>
    </div>

    <div class="footer">
        <p>SCAN. SOLVE. CONQUER.</p>
    </div>
</body>
</html>
