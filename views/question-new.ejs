<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Treasure Hunt Question</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
        .warning-banner {
            background-color: var(--neo-pink);
            border: 4px solid #000;
            padding: 20px;
            margin-bottom: 30px;
            text-align: center;
            box-shadow: 8px 8px 0 #000;
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.02); }
        }
        .warning-text {
            font-size: 1.8rem;
            font-weight: 900;
            color: #000;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }
        .question-heading {
            background-color: var(--neo-yellow);
            border: 4px solid #000;
            padding: 15px 30px;
            margin-bottom: 30px;
            text-align: center;
            box-shadow: 6px 6px 0 #000;
            display: inline-block;
            transform: rotate(-1deg);
        }
        .question-heading-text {
            font-size: 1.3rem;
            font-weight: 900;
            color: #000;
            text-transform: uppercase;
            letter-spacing: 0.1em;
        }
        .matching-container {
            display: grid;
            gap: 20px;
        }
        .matching-row {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            gap: 15px;
            align-items: center;
            background-color: #f9f9f9;
            padding: 20px;
            border: 3px solid #000;
        }
        .match-left {
            font-weight: bold;
            color: #000;
            font-size: 1.1rem;
        }
        .match-arrow {
            font-size: 1.5rem;
        }
        .match-select {
            padding: 12px;
            font-size: 1rem;
            font-weight: bold;
            border: 3px solid #000;
            background-color: var(--neo-yellow);
            font-family: "Courier New", monospace;
            text-transform: uppercase;
        }
        .error-message {
            background-color: var(--neo-pink);
            color: #000;
            padding: 20px;
            border: 4px solid #000;
            margin-bottom: 20px;
            font-weight: bold;
            font-size: 1.1rem;
            text-align: center;
            box-shadow: 6px 6px 0 #000;
        }
    </style>
</head>
<body>
    <div class="grid-bg"></div>

    <div class="container">

        <% if (error) { %>
        <div class="error-message">
            <%= error %>
        </div>
        <% } %>

        <div class="quiz-card">
            <div style="text-align: center; margin-bottom: 30px;">
                <div class="question-heading">
                    <div class="question-heading-text">Your Question</div>
                </div>
            </div>

            <div class="question-box">
                <div class="question-text"><%= question.question %></div>
            </div>

            <form id="answerForm" class="quiz-form">
                <% if (question.type === 'mcq' || question.type === 'truefalse') { %>
                    <!-- Multiple Choice -->
                    <div class="options-grid">
                        <% question.options.forEach((option, index) => { %>
                        <label class="option-card">
                            <input type="radio" name="answer" value="<%= option %>" required>
                            <div class="option-content">
                                <div><%= option %></div>
                            </div>
                        </label>
                        <% }) %>
                    </div>

                <% } else if (question.type === 'fill') { %>
                    <!-- Fill in the Blank -->
                    <div class="answer-input-container">
                        <textarea 
                            id="answerInput" 
                            name="answer" 
                            placeholder="Type your answer here..."
                            required
                        ></textarea>
                    </div>

                <% } else if (question.type === 'matching') { %>
                    <!-- Matching -->
                    <div class="matching-container">
                        <% if (question.columnA && question.columnB) { %>
                            <% question.columnA.forEach((item, index) => { %>
                            <div class="matching-row">
                                <div class="match-left"><strong><%= item.key %>.</strong> <%= item.value %></div>
                                <div class="match-arrow">→</div>
                                <select name="match_<%= item.key %>" class="match-select" required>
                                    <option value="">Select match...</option>
                                    <% question.columnB.forEach(opt => { %>
                                    <option value="<%= opt.key %>"><%= opt.key %>. <%= opt.value %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <% }) %>
                        <% } else if (question.pairs) { %>
                            <% question.pairs.forEach((pair, index) => { %>
                            <div class="matching-row">
                                <div class="match-left"><%= pair.left %></div>
                                <div class="match-arrow">→</div>
                                <select name="match_<%= index %>" class="match-select" required>
                                    <option value="">Select match...</option>
                                    <% question.options.forEach(opt => { %>
                                    <option value="<%= opt %>"><%= opt %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <% }) %>
                        <% } %>
                    </div>
                <% } %>

                <% if (typeof locationSlug !== 'undefined' && locationSlug) { %>
                <input type="hidden" name="locationSlug" value="<%= locationSlug %>">
                <% } %>
                <input type="hidden" name="questionType" value="<%= question.type %>">

                <button type="submit" class="submit-btn" id="submitBtn">
                    <span>SUBMIT ANSWER</span>
                    <span class="btn-arrow">→</span>
                </button>
            </form>
        </div>
    </div>

    <script>
        document.getElementById('answerForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.disabled = true;
            submitBtn.style.opacity = '0.6';
            submitBtn.innerHTML = '<span>SUBMITTING...</span>';

            const formData = new FormData(this);
            let answer;

            const questionType = formData.get('questionType');
            
            if (questionType === 'mcq' || questionType === 'truefalse') {
                answer = formData.get('answer');
            } else if (questionType === 'fill') {
                answer = document.getElementById('answerInput').value.trim();
            } else if (questionType === 'matching') {
                const matches = {};
                for (let [key, value] of formData.entries()) {
                    if (key.startsWith('match_')) {
                        const matchKey = key.replace('match_', '');
                        matches[matchKey] = value;
                    }
                }
                answer = JSON.stringify(matches);
            }

            const locationSlug = formData.get('locationSlug');

            fetch('/submit-answer', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ answer, locationSlug })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    history.pushState(null, null, location.href);
                    window.onpopstate = function () {
                        history.go(1);
                    };
                    window.location.href = data.redirect || '/dashboard';
                } else {
                    history.pushState(null, null, location.href);
                    window.onpopstate = function () {
                        history.go(1);
                    };
                    
                    if (data.redirect) {
                        window.location.href = data.redirect;
                    } else {
                        alert(data.message || 'Error submitting answer');
                        submitBtn.disabled = false;
                        submitBtn.style.opacity = '1';
                        submitBtn.innerHTML = '<span>SUBMIT ANSWER</span><span class="btn-arrow">→</span>';
                    }
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert('Failed to submit answer. Please try again.');
                submitBtn.disabled = false;
                submitBtn.style.opacity = '1';
                submitBtn.innerHTML = '<span>SUBMIT ANSWER</span><span class="btn-arrow">→</span>';
            });
        });
        
        history.pushState(null, null, location.href);
        window.onpopstate = function () {
            history.go(1);
        };
    </script>
</body>
</html>