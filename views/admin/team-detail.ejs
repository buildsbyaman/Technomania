<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= team.teamName %> - Admin</title>
  <link rel="stylesheet" href="/styles.css">
  <style>
    body { background: #f5f5f5; }
    .admin-header {
      background: #000;
      color: white;
      padding: 20px;
      border-bottom: 4px solid var(--neo-yellow);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .admin-title { 
      font-size: 1.8rem; 
      font-weight: 900; 
      text-transform: uppercase;
      color: var(--neo-yellow);
    }
    .admin-nav { display: flex; gap: 15px; }
    .admin-nav a {
      color: #000;
      background: var(--neo-white);
      text-decoration: none;
      font-weight: 900;
      padding: 10px 20px;
      border: 3px solid var(--neo-yellow);
      transition: all 0.2s;
    }
    .admin-nav a:hover { 
      background: var(--neo-yellow); 
      color: #000;
      transform: translate(-2px, -2px);
      box-shadow: 4px 4px 0 var(--neo-yellow);
    }
    .logout-btn { 
      background: var(--neo-pink) !important; 
      border-color: var(--neo-pink) !important;
    }
    .container { max-width: 1200px; margin: 40px auto; padding: 0 20px; }
    .back-link {
      display: inline-block;
      margin-bottom: 20px;
      padding: 10px 20px;
      background: var(--neo-cyan);
      color: #000;
      text-decoration: none;
      font-weight: 900;
      border: 3px solid #000;
      box-shadow: 4px 4px 0 #000;
    }
    .back-link:hover { 
      background: var(--neo-yellow); 
      transform: translate(-2px, -2px);
      box-shadow: 6px 6px 0 #000;
    }
    .team-header {
      background: var(--neo-yellow);
      border: 4px solid #000;
      padding: 30px;
      margin-bottom: 30px;
      box-shadow: 8px 8px 0 #000;
    }
    .team-title { font-size: 2.5rem; font-weight: 900; margin-bottom: 15px; color: #000; }
    .edit-form { display: flex; gap: 20px; margin-top: 20px; }
    .edit-form input {
      flex: 1;
      padding: 12px;
      border: 3px solid #000;
      font-weight: bold;
      font-family: 'Courier New', monospace;
      background: var(--neo-white);
      color: #000;
    }
    .btn {
      padding: 12px 24px;
      font-weight: 900;
      border: 3px solid #000;
      cursor: pointer;
      text-transform: uppercase;
      font-family: 'Courier New', monospace;
      transition: all 0.2s;
    }
    .btn:hover {
      transform: translate(-2px, -2px);
      box-shadow: 4px 4px 0 #000;
    }
    .btn-save { background: var(--neo-green); color: #000; }
    .btn-delete { background: var(--neo-pink); color: #000; }
    .section-title {
      font-size: 1.8rem;
      font-weight: 900;
      text-transform: uppercase;
      margin: 30px 0 20px;
      padding-bottom: 10px;
      border-bottom: 4px solid #000;
      color: #000;
    }
    .questions-list {
      display: grid;
      gap: 20px;
    }
    .question-card {
      background: var(--neo-white);
      border: 4px solid #000;
      padding: 25px;
      box-shadow: 6px 6px 0 #000;
    }
    .question-round {
      display: inline-block;
      padding: 5px 15px;
      background: var(--neo-cyan);
      border: 2px solid #000;
      font-weight: 900;
      margin-bottom: 15px;
      color: #000;
    }
    .question-text {
      font-weight: bold;
      margin-bottom: 15px;
      line-height: 1.6;
      color: #000;
    }
    .answer-section {
      background: #f0f0f0;
      border: 3px solid #000;
      padding: 15px;
      margin-top: 15px;
    }
    .answer-row {
      display: flex;
      justify-content: space-between;
      padding: 8px 0;
      font-weight: bold;
      color: #000;
    }
    .status-answered { 
      background: var(--neo-green); 
      padding: 5px 10px; 
      border: 2px solid #000;
      color: #000;
    }
    .status-pending { 
      background: #ffa500; 
      padding: 5px 10px; 
      border: 2px solid #000;
      color: #000;
    }
    .badge-correct { background: var(--neo-green); color: #000; padding: 5px 10px; border: 2px solid #000; font-weight: 900; }
    .badge-wrong { background: var(--neo-pink); color: #000; padding: 5px 10px; border: 2px solid #000; font-weight: 900; }
  </style>
</head>
<body>
  <div class="admin-header">
    <div class="admin-title">Team Details</div>
    <div class="admin-nav">
      <a href="/admin/dashboard">Dashboard</a>
      <a href="/admin/logout" class="logout-btn">Logout</a>
    </div>
  </div>

  <div class="container">
    <a href="/admin/dashboard" class="back-link">← Back to Dashboard</a>
    
    <div class="team-header">
      <div class="team-title"><%= team.teamName %></div>
      <div style="font-weight: bold; color: #000; margin: 10px 0;">
        <strong>Team ID:</strong> <%= team.teamId %> | 
        <strong>Passcode:</strong> <%= team.passcode %>
      </div>
      <div style="font-weight: bold; color: #000; margin: 10px 0;">
        <strong>Current Round:</strong> <%= team.currentRound %> | 
        <strong>Status:</strong> 
        <% 
          let statusColor = 'pink';
          if (team.status === 'completed') statusColor = 'green';
          else if (team.status === 'active') statusColor = 'cyan';
        %>
        <span style="background: var(--neo-<%= statusColor %>); padding: 5px 10px; border: 2px solid #000;"><%= team.status.toUpperCase() %></span>
      </div>
      <div style="font-weight: bold; color: #000;">
        <strong>Questions Answered:</strong> <%= team.questionsAnswered %>/3
      </div>
      
      <form method="POST" action="/admin/teams/<%= team._id %>/edit" class="edit-form">
        <input type="text" name="teamName" value="<%= team.teamName %>" placeholder="Team Name" required>
        <input type="text" name="passcode" value="<%= team.passcode %>" placeholder="Passcode" required>
        <button type="submit" class="btn btn-save">Save Changes</button>
      </form>
      
      <form method="POST" action="/admin/teams/<%= team._id %>/delete" style="margin-top: 20px;" 
            onsubmit="return confirm('Are you sure you want to delete this team?')">
        <button type="submit" class="btn btn-delete">Delete Team</button>
      </form>
    </div>

    <h2 class="section-title">Assigned Clues (<%= team.assignedClues.length %>)</h2>
    <% if (team.assignedClues.length > 0) { %>
      <div class="questions-list">
        <% team.assignedClues.forEach(function(clue) { %>
          <div class="question-card">
            <span class="question-round">ROUND <%= clue.round %></span>
            <div style="margin: 15px 0; color: #000;">
              <strong style="color: #000;">Clue:</strong><br>
              <div style="font-style: italic; margin: 10px 0; padding: 15px; background: var(--neo-yellow); border: 2px solid #000; color: #000;">
                "<%= clue.clueData.question %>"
              </div>
            </div>
            <div style="margin: 10px 0; color: #000;">
              <strong style="color: #000;">Location:</strong> <%= clue.clueData.correctAnswer %>
            </div>
            <div style="margin: 10px 0; color: #000;">
              <strong style="color: #000;">Slug:</strong> <code style="background: var(--neo-cyan); padding: 5px 10px; border: 2px solid #000; color: #000;">/location/<%= clue.clueData.locationSlug %></code>
            </div>
            <div style="margin: 10px 0; color: #000;">
              <strong style="color: #000;">Assigned:</strong> <%= formatDate(clue.assignedAt) %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div style="background: white; color: #000; border: 4px solid #000; padding: 40px; text-align: center; margin-bottom: 30px;">
        No clues assigned yet
      </div>
    <% } %>

    <h2 class="section-title">Assigned Questions (<%= team.assignedQuestions.length %>)</h2>
    <div class="questions-list">
      <% team.assignedQuestions.forEach(function(q) { %>
        <div class="question-card">
          <span class="question-round">ROUND <%= q.round %></span>
          <div class="question-text"><strong style="color: #000;">Q:</strong> <%= q.questionData.question %></div>
          
          <% if (q.questionData.type === 'mcq' && q.questionData.options) { %>
            <div style="margin: 15px 0; color: #000;">
              <strong style="color: #000;">Options:</strong>
              <ul style="margin-top: 10px; color: #000;">
                <% q.questionData.options.forEach(function(opt) { %>
                  <li style="padding: 5px 0; color: #000;"><%= opt %></li>
                <% }); %>
              </ul>
            </div>
          <% } %>
          
          <div style="margin: 10px 0; padding: 10px; background: var(--neo-green); border: 2px solid #000; color: #000;">
            <strong style="color: #000;">Correct Answer:</strong> <%= q.questionData.correctAnswer %>
          </div>
          
          <div class="answer-section">
            <% if (q.attempted) { %>
              <div class="answer-row">
                <span style="color: #000;">Status:</span>
                <span class="status-answered">Attempted</span>
              </div>
              <div class="answer-row">
                <span>Given Answer:</span>
                <span><strong><%= q.givenAnswer %></strong></span>
              </div>
              <div class="answer-row">
                <span>Result:</span>
                <span class="<%= q.isCorrect ? 'badge-correct' : 'badge-wrong' %>">
                  <%= q.isCorrect ? 'Correct' : 'Wrong' %>
                </span>
              </div>
              <div class="answer-row">
                <span>Answered At:</span>
                <span><%= formatDate(q.answeredAt) %></span>
              </div>
              
              <% if (!q.isCorrect) { %>
                <form method="POST" action="/admin/teams/<%= team._id %>/approve-answer" style="margin-top: 15px;">
                  <input type="hidden" name="round" value="<%= q.round %>">
                  <%
                    var confirmMsg = team.status === 'locked_out' 
                      ? 'Mark this answer as correct and unlock the team?' 
                      : 'Mark this answer as correct?';
                    var btnText = team.status === 'locked_out' ? ' & Unlock Team' : '';
                  %>
                  <button type="submit" class="btn" style="background: var(--neo-green); width: 100%;" 
                          onclick="return confirm('<%= confirmMsg %>')">
                    Mark as Correct<%= btnText %>
                  </button>
                </form>
              <% } %>
            <% } else { %>
              <div class="answer-row">
                <span style="color: #000;">Status:</span>
                <span class="status-pending">Not attempted yet</span>
              </div>
            <% } %>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</body>
</html>
