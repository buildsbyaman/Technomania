<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Treasure Hunt</title>
    <link rel="stylesheet" href="/styles.css">
    <style>
        .clue-card {
            background-color: var(--neo-yellow);
            border: 4px solid #000;
            padding: 40px;
            margin: 30px 0;
            box-shadow: 12px 12px 0 #000;
            position: relative;
        }
        .clue-label {
            position: absolute;
            top: -20px;
            left: 20px;
            background-color: var(--neo-pink);
            color: #000;
            padding: 10px 25px;
            font-weight: 900;
            font-size: 1.1rem;
            border: 4px solid #000;
            text-transform: uppercase;
        }
        .clue-text {
            font-size: 1.5rem;
            font-weight: bold;
            color: #000;
            line-height: 1.8;
            font-style: italic;
            margin-bottom: 20px;
        }
        .location-hint {
            background-color: #000;
            color: var(--neo-white);
            padding: 15px 25px;
            font-weight: bold;
            font-size: 1.2rem;
            border: 4px solid var(--neo-white);
            display: inline-block;
            text-transform: uppercase;
        }
        .instructions-box {
            background-color: var(--neo-cyan);
            border: 4px solid #000;
            padding: 25px;
            margin-top: 25px;
            box-shadow: 6px 6px 0 #000;
        }
        .instructions-box ol {
            margin-left: 20px;
            line-height: 2;
            font-weight: bold;
            color: #000;
        }
        .logout-btn {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 12px 24px;
            background: var(--neo-pink);
            color: #000;
            text-decoration: none;
            font-weight: 900;
            border: 3px solid #000;
            box-shadow: 4px 4px 0 #000;
            text-transform: uppercase;
            z-index: 999;
        }
        .logout-btn:hover {
            transform: translate(-2px, -2px);
            box-shadow: 6px 6px 0 #000;
        }
    </style>
</head>
<body>
    <div class="grid-bg"></div>
    
    <a href="/logout" class="logout-btn">Logout</a>

    <div class="container">

        <% if (currentRound === 1 && !hasClue) { %>
            <!-- Starting Point -->
            <div class="quiz-card">
                <div class="result-emoji"></div>
                <h1 class="result-title">BEGIN YOUR QUEST!</h1>
                
                <div class="result-actions">
                    <a href="/start" class="submit-btn" style="text-decoration: none; width: auto;">
                        <span>START ROUND 1</span>
                        <span class="btn-arrow">→</span>
                    </a>
                </div>
            </div>

        <% } else if (hasClue && clue) { %>
            <!-- Active Round with Clue -->
            <div class="quiz-card">
                <div class="clue-card">
                    <div class="clue-label">YOUR CLUE</div>
                    <div class="clue-text">"<%= clue.question %>"</div>
                </div>

                <div class="instructions-box">
                    <h3 style="color: #000; margin-bottom: 15px; font-size: 1.3rem; text-transform: uppercase;">
                        WHAT TO DO NEXT
                    </h3>
                    <ol style="color: #000;">
                        <li>Solve the clue to find the location</li>
                        <li>Scan the QR code at that location</li>
                        <li>Answer the question (ONE ATTEMPT ONLY!)</li>
                    </ol>
                </div>
            </div>

        <% } else { %>
            <!-- Waiting State -->
            <div class="quiz-card">
                <div class="result-emoji"></div>
                <h2 class="result-title" style="font-size: 3rem;">HOLD ON!</h2>
                <p class="result-text">
                    Your next clue will appear here after you answer the current question correctly.
                </p>
            </div>
        <% } %>
    </div>
    
    <script>
        <% if (team && team.questionsAnswered > 0) { %>
            history.pushState(null, null, location.href);
            window.onpopstate = function () {
                history.go(1);
            };
        <% } %>
    </script>
</body>
</html>