<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Treasure Hunt Login</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <div class="grid-bg"></div>
    
    <div class="marquee">
        <div class="marquee-content">
            <span>TREASURE HUNT 2026</span>
            <span>FIND THE CLUES</span>
            <span>WIN BIG</span>
            <span>TREASURE HUNT 2026</span>
            <span>FIND THE CLUES</span>
            <span>WIN BIG</span>
        </div>
    </div>

    <div class="container">
        <div class="header">
            <div class="title">
                <div class="title-main">TREASURE</div>
                <div class="title-sub">HUNT</div>
            </div>
        </div>

        <div class="quiz-card">
            <div class="card-label">LOGIN</div>
            
            <% if (error) { %>
                <div class="result-message" style="background-color: var(--neo-pink); color: #000; margin-bottom: 30px;">
                    <%= error %>
                </div>
            <% } %>

            <form action="/login" method="POST" class="quiz-form">
                <div class="form-group">
                    <label class="form-label">Team ID</label>
                    <input 
                        type="text" 
                        name="teamId" 
                        class="form-input" 
                        placeholder="TEAM001" 
                        required 
                        autocapitalize="characters"
                        style="text-transform: uppercase;">
                </div>

                <div class="form-group">
                    <label class="form-label">Passcode</label>
                    <input 
                        type="text" 
                        name="passcode" 
                        class="form-input" 
                        placeholder="PASS001" 
                        required 
                        autocapitalize="characters"
                        style="text-transform: uppercase;">
                </div>

                <button type="submit" class="submit-btn">
                    <span>START HUNT</span>
                    <span class="btn-arrow">→</span>
                </button>
            </form>
        </div>
    </div>

    <div class="footer">
        <p>SCAN. SOLVE. CONQUER.</p>
    </div>
</body>
</html>
