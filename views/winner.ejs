<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Submission Complete</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="grid-bg"></div>

    <div class="container">
      <div class="quiz-card">
        <div class="result-emoji"></div>

        <h1
          class="result-title"
          style="font-size: clamp(2rem, 8vw, 4rem); color: #000"
        >
          THANK YOU!
        </h1>

        <div class="result-info">
          <p class="result-text">You have completed all 3 rounds.</p>
          <p class="result-text" style="font-size: 1.3rem; margin-top: 30px">
            Our team will contact you shortly for the results.
          </p>
        </div>

        <div class="result-actions" style="margin-top: 50px">
          <a href="/logout" class="action-btn secondary"> LOGOUT </a>
        </div>
      </div>
    </div>

    <script></script>
  </body>
</html>
