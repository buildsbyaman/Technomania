<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Final Clue</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <div class="grid-bg"></div>

    <div class="container">
      <div class="header">
        <h1 class="welcome-title">TREASURE HUNT COMPLETE</h1>
      </div>

      <div class="quiz-card">
        <div style="text-align: center; margin-bottom: 30px">
          <div
            style="
              background-color: var(--neo-green);
              color: #000;
              padding: 15px 40px;
              font-size: 2rem;
              font-weight: 900;
              text-transform: uppercase;
              box-shadow: 8px 8px 0 var(--neo-pink);
              border: 4px solid #000;
              display: inline-block;
              margin-bottom: 30px;
            "
          >
            FINAL CLUE
          </div>
        </div>

        <div
          style="
            text-align: center;
            font-size: 1.5rem;
            font-weight: bold;
            font-style: italic;
            color: #000;
            margin: 30px 0;
            padding: 20px;
            background-color: var(--neo-yellow);
            border: 4px solid #000;
            box-shadow: 6px 6px 0 var(--neo-cyan);
          "
        >
          End is the new beginning…the end is calling ✨
        </div>

        <div
          style="
            text-align: center;
            margin-top: 40px;
            padding: 30px;
            background-color: #000;
            color: var(--neo-white);
            border: 4px solid var(--neo-pink);
          "
        >
          <p style="font-size: 1.2rem; margin-bottom: 15px">
            You have completed all 3 rounds.
          </p>
          <p style="font-size: 1rem">
            Our team will contact you shortly for the results.
          </p>
        </div>

        <div style="text-align: center; margin-top: 40px">
          <a
            href="/logout"
            style="
              background-color: var(--neo-pink);
              color: #000;
              padding: 15px 50px;
              font-size: 1.2rem;
              font-weight: 900;
              text-transform: uppercase;
              text-decoration: none;
              border: 4px solid #000;
              box-shadow: 8px 8px 0 var(--neo-green);
              display: inline-block;
              transition: all 0.2s;
            "
            onmouseover="
              this.style.transform = 'translate(-4px, -4px)';
              this.style.boxShadow = '12px 12px 0 var(--neo-green)';
            "
            onmouseout="
              this.style.transform = '';
              this.style.boxShadow = '8px 8px 0 var(--neo-green)';
            "
          >
            LOGOUT
          </a>
        </div>
      </div>
    </div>
  </body>
</html>
